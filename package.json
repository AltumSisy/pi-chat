{
  "name": "pi-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"pnpm server:dev\" \"pnpm web:dev\"",
    "dev:debug": "concurrently -k -n api,web -c green,cyan \"pnpm server:debug\" \"pnpm web:dev\"",
    "web:dev": "vite",
    "server:dev": "tsx --watch --tsconfig tsconfig.node.json --env-file-if-exists=.env server/index.ts",
    "server:dev:native": "node --watch --env-file-if-exists=.env server/index.ts",
    "server:debug": "node --inspect=9229 --env-file-if-exists=.env server/index.ts",
    "server:debug:watch": "node --watch --inspect=9229 --env-file-if-exists=.env server/index.ts",
    "server:debug:keepalive": "node scripts/serve-keepalive.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "donet": "^1.0.1",
    "glimm": "^0.3.1",
    "hono": "^4.13.8",
    "hono-pino": "^0.10.3",
    "lucide-react": "^1.52.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "shadow-plugin": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
